# Frontend Environment Variables Template
# Copy this file to .env and .env.production and fill in the values

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here
React_App_GOOGLE_CALLBACK=http://localhost:3000/oauth2callback
React_App_GOOGLE_SECRET=your-google-secret-here

# External API Keys
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
REACT_APP_UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# Development Host (Optional)
HOST=0.0.0.0

# NOTES:
# - All frontend environment variables MUST start with REACT_APP_ to be accessible in React
# - Never commit .env or .env.production files to version control
# - For production, update REACT_APP_API_BASE_URL to your deployed backend URL
# - For production, update React_App_GOOGLE_CALLBACK to your deployed frontend URL
